{
  "name": "kaledu-konkursas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/admin.ts",
    "seed:dev": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test": "tsx --env-file-if-exists=.env --test tests/*.test.ts",
    "test:db": "tsx --env-file-if-exists=.env --test --test-concurrency=1 tests/database.test.ts",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "csv-parse": "^6.1.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
